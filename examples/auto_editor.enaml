from enaml.widgets.api import *
from enaml.layout.api import *
from atom.api import *
from enamlext.auto import Editor

class Person(Atom):
    first_name = Str()
    last_name = Str().tag(label='Last Name')
    age = Int()
    height = Float().tag(label='Height (m)')
    drummer = Bool()

    @observe('first_name', 'last_name', 'age', 'height', 'drummer')
    def _print_change(self, change):
        print(change['name'], 'changed:', change['value'])


enamldef Main(Window): mw:
    title = 'Auto Editor Example'

    attr person = Person(first_name='Ringo', last_name='Starr', age=24, height=1.68, drummer=True)

    Container:
        Editor:
            obj << mw.person

        PushButton:
            text = 'Print Person Attributes'
            clicked ::
                print(person)
